# Servidor
PORT=3001

# Banco de dados PostgreSQL (local ou Neon/Render/Supabase)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/jobtracker

# JWT (em produção use um valor longo e aleatório)
JWT_SECRET=troque-por-uma-chave-secreta-longa
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula (ex.: a URL do front na Vercel)
# Deixe vazio no desenvolvimento para liberar todas
CORS_ORIGIN=

# Conta demo (criada automaticamente ao iniciar o servidor)
DEMO_ENABLED=true
DEMO_EMAIL=demo@jobtracker.dev
DEMO_PASSWORD=demo1234
